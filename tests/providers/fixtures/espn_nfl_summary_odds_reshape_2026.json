   {
    "type": "event",
    "uid": "s:20~l:28~e:401873065",
    "guid": "660b38f2-90ce-3f68-8258-3bf2b1a46db1",
    "description": "Los Angeles Chargers @ Baltimore Ravens",
    "eventId": 401873065,
    "event": {
